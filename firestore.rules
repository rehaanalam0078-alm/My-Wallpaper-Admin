rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to verify admin authorization via custom claims
    function isAdmin() {
      return request.auth != null && 
        (request.auth.token.admin == true || request.auth.token.role == 'admin');
    }

    // 1. Wallpapers collection
    // - Public read for the Android consumer application
    // - Writes (create, update, delete) restricted strictly to authorized administrators
    match /wallpapers/{wallpaperId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 2. Categories collection
    // - Public read so Android app and admin panel can view all categories
    // - Writes (create, update, delete) restricted strictly to authorized administrators
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 3. Upload batches (history)
    // - Admin only read & write
    match /upload_batches/{batchId} {
      allow read, write: if isAdmin();
    }

    // 4. Admin accounts and audit collection
    // - Admin only read & write
    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }

    // 5. Users collection & subcollections
    match /users/{userId} {
      // Authenticated users can read and write their own profile document;
      // Admins can read user profiles to inspect notification preferences.
      allow read: if (request.auth != null && request.auth.uid == userId) || isAdmin();
      allow write: if request.auth != null && request.auth.uid == userId;

      // User favorites subcollection: strictly owned by the authenticated user
      match /favorites/{wallpaperId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // User in-app notifications: read, update (mark as read), and delete by owner;
      // create allowed by admin/server or authenticated owner
      match /notifications/{notificationId} {
        allow read, update, delete: if request.auth != null && request.auth.uid == userId;
        allow create: if isAdmin() || (request.auth != null && request.auth.uid == userId);
      }

      // User FCM device registration tokens
      match /fcmTokens/{tokenId} {
        allow read: if (request.auth != null && request.auth.uid == userId) || isAdmin();
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // 6. Internal idempotency events collection (Admin / Cloud Function only)
    match /events/{eventId} {
      allow read, write: if isAdmin();
    }
  }
}
